{
  "$description": "ketch brand (catch releases from GitHub: a hook catching a release-tag chip). Local deltas only; extends @pyrlyn/brand base/tokens.json (pinned in package.json), built by `node build.mjs` into dist/tokens.css. Source: pyrlyn/ketch@7bec33c site/static/css/main.css (theme blocks) and site/DESIGN.md. Roles map the site's names: canvas→bg, surface-1→surface, hairline→border, ink→fg, ink-muted→fg-muted, ink-faint→fg-subtle, accent-soft→accent-muted, accent-on→on-accent, elev-1..3→shadow-e1..e3. Keys that are not base roles become --ketch-*. Status roles (success, warn, danger and their -fg text variants) come from desktop/design/tokens.json status.* and are checked for WCAG AA in README.md.",
  "$extends": "@pyrlyn/brand/base/tokens.json",
  "$extensions": {
    "com.pyrlyn.brand": "ketch",
    "com.pyrlyn.defaultTheme": "light"
  },
  "brand": {
    "$description": "Brand constants, identical in both themes.",
    "teal": {
      "$type": "color",
      "$value": "#0A3D36",
      "$description": "logo tile (always dark)"
    },
    "mint": {
      "$type": "color",
      "$value": "#3DDCB0",
      "$description": "hook stroke, dark accent"
    },
    "coral": {
      "$type": "color",
      "$value": "#FF6B5B",
      "$description": "release-tag chip"
    }
  },
  "theme": {
    "$description": "Per theme. Light is the default (the site's :root).",
    "light": {
      "bg": {
        "$type": "color",
        "$value": "#F4F8F7",
        "$description": "page ground (site: --canvas)"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "raised panels (--surface-1)"
      },
      "surface-2": {
        "$type": "color",
        "$value": "#EAF1EF",
        "$description": "sunken / chip / code (--surface-2)"
      },
      "border": {
        "$type": "color",
        "$value": "#D5E3DF",
        "$description": "hairline (--hairline)"
      },
      "fg": {
        "$type": "color",
        "$value": "#0B1A18",
        "$description": "primary text (--ink)"
      },
      "fg-muted": {
        "$type": "color",
        "$value": "#5A7380",
        "$description": "secondary text (--ink-muted)"
      },
      "fg-subtle": {
        "$type": "color",
        "$value": "#7A929C",
        "$description": "meta (--ink-faint)"
      },
      "accent": {
        "$type": "color",
        "$value": "#0F6F5C",
        "$description": "links, primary actions"
      },
      "accent-muted": {
        "$type": "color",
        "$value": "#D8F0E8",
        "$description": "soft accent wash (--accent-soft)"
      },
      "on-accent": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "text on accent fill (--accent-on)"
      },
      "success": {
        "$type": "color",
        "$value": "#1F9D57",
        "$description": "status fill (desktop status.installedSubtle); 3.26:1 on bg"
      },
      "success-fg": {
        "$type": "color",
        "$value": "#12683A",
        "$description": "status text (desktop status.installed); >= 5.98:1 on bg, surface, surface-2"
      },
      "warn": {
        "$type": "color",
        "$value": "#E0A100",
        "$description": "status fill (desktop status.warningSubtle); 2.12:1 on bg, so pair it with warn-fg text or an outline, label it with fg (7.89:1)"
      },
      "warn-fg": {
        "$type": "color",
        "$value": "#774B00",
        "$description": "status text (desktop status.warning); >= 6.57:1"
      },
      "danger": {
        "$type": "color",
        "$value": "#E0314B",
        "$description": "status fill (desktop status.errorSubtle); 4.16:1 on bg"
      },
      "danger-fg": {
        "$type": "color",
        "$value": "#A81E34",
        "$description": "status text (desktop status.error); >= 6.32:1"
      },
      "mark-tile": {
        "$type": "color",
        "$value": "{brand.teal}",
        "$description": "logo tile, always dark"
      },
      "shadow-e1": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(11, 26, 24, 0.04), 0 1px 3px rgba(11, 26, 24, 0.06)",
        "$description": "--elev-1"
      },
      "shadow-e2": {
        "$type": "shadow",
        "$value": "0 4px 12px rgba(11, 26, 24, 0.06), 0 1px 3px rgba(11, 26, 24, 0.04)",
        "$description": "--elev-2"
      },
      "shadow-e3": {
        "$type": "shadow",
        "$value": "0 12px 32px rgba(11, 26, 24, 0.10), 0 2px 6px rgba(11, 26, 24, 0.05)",
        "$description": "--elev-3"
      },
      "accent-bright": {
        "$type": "color",
        "$value": "#1FA88A",
        "$description": "hover accent"
      },
      "glass-fill": {
        "$type": "string",
        "$value": "rgba(255, 255, 255, 0.72)",
        "$description": "glass panels"
      },
      "glass-border": {
        "$type": "string",
        "$value": "rgba(213, 227, 223, 0.9)",
        "$description": "glass panel border"
      },
      "focus-ring": {
        "$type": "shadow",
        "$value": "0 0 0 3px rgba(15, 111, 92, 0.35)",
        "$description": "themed soft focus ring"
      },
      "tag-coral": {
        "$type": "color",
        "$value": "{brand.coral}",
        "$description": "release-tag chip"
      },
      "stage": {
        "$type": "color",
        "$value": "#E8F2EE",
        "$description": "hero stage"
      },
      "term-bg": {
        "$type": "color",
        "$value": "#0A1214",
        "$description": "terminal chrome, dark in both themes"
      },
      "term-surface": {
        "$type": "color",
        "$value": "#101A1C"
      },
      "term-ink": {
        "$type": "color",
        "$value": "#E8F4F1"
      },
      "term-dim": {
        "$type": "color",
        "$value": "#8AA8A0"
      },
      "term-accent": {
        "$type": "color",
        "$value": "{brand.mint}"
      },
      "term-hairline": {
        "$type": "color",
        "$value": "#1E3330"
      }
    },
    "dark": {
