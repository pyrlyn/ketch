<Page
    x:Class="KetchApp.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:KetchApp"
    xmlns:core="using:Ketch.AppCore">
    <ScrollViewer>
        <StackPanel Padding="32,16,32,24" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Appearance" />
                <!-- High contrast is not a choice here: Windows switches the
                     tokens' HighContrast colours in by itself when it is on. -->
                <ComboBox
                    x:Name="Theme"
                    MinWidth="260"
                    Header="Theme"
                    SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="Use system setting" Tag="Default" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="App" />
                <ToggleSwitch
                    x:Name="Tray"
                    Header="Show the notification area icon"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="OnTrayToggled" />
                <ToggleSwitch
                    x:Name="Notices"
                    Header="Notify when updates are available"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="OnNoticesToggled" />
                <ToggleSwitch
                    x:Name="Login"
                    Header="Start at login"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="OnLoginToggled" />
                <ToggleSwitch
                    x:Name="Links"
                    Header="Open ketch links"
                    OffContent="Off"
                    OnContent="On"
                    Toggled="OnLinksToggled" />
                <TextBlock
                    x:Name="ShellStatus"
                    Foreground="{ThemeResource KetchColorStatusErrorBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ketch root" />
                <TextBlock
                    x:Name="Root"
                    FontFamily="Cascadia Mono"
                    IsTextSelectionEnabled="True" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Shared with the ketch CLI. The app stores no tokens."
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Shown only on the fake core (KETCH_APP_FAKE_CORE=1). -->
            <StackPanel x:Name="FakeCore" Spacing="4">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Fake core (development)" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="The app runs on a fake core that replays the contract scenarios. Pick one to play it for the next install, upgrade or uninstall."
                    TextWrapping="Wrap" />
                <ComboBox
                    x:Name="Scenario"
                    MinWidth="320"
                    Header="Next mutation plays"
                    SelectionChanged="OnScenarioChanged" />
                <TextBlock
                    x:Name="ScenarioText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
